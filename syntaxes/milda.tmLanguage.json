{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Milda",
  "scopeName": "source.milda",
  "fileTypes": [
    "milda"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#valueLiteral"
    },
    {
      "include": "#declaredType"
    },
    {
      "include": "#declaredName"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#number"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#property"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.milda"
    },
    "string": {
      "match": "\"(?:\\\\.|[^\"\\\\])*\"?",
      "name": "string.quoted.double.milda"
    },
    "valueLiteral": {
      "match": "(?<![A-Za-z0-9_./%$-])(scaled|oklch|srgb|rgba|hsla|hex|rgb|hsl|p3)(\\s*\\()([^)\\n]*)(\\))",
      "captures": {
        "1": {
          "name": "support.type.milda"
        },
        "3": {
          "name": "constant.numeric.milda"
        }
      }
    },
    "declaredType": {
      "match": "(:)(\\s*)(?!(?:context-group|described-by|presentation|foundations|global-prop|labelled-by|destination|labeled-by|transition|component|archetype|broadcast|behaviour|copyright|otherwise|required|requires|ancestor|keyed-by|optional|instance|behavior|prelude|because|realize|present|compute|default|payload|foreign|example|one-of|any-of|within|prefer|events|motion|layout|escape|commit|active|single|signal|locked|repeat|assets|anchor|milda|token|where|never|props|state|alias|arena|false|emits|icons|meta|type|rule|uses|wire|gate|part|when|slot|from|bind|drop|note|many|true|pill|a11y|demo|docs|and|not|raw|or|by|as|on|of)(?![A-Za-z0-9_./%$-]))([A-Za-z][A-Za-z0-9_./%$-]*)",
      "captures": {
        "1": {
          "name": "keyword.operator.milda"
        },
        "3": {
          "name": "support.type.milda"
        }
      }
    },
    "declaredName": {
      "match": "(?<![A-Za-z0-9_./%$-])(context-group|global-prop|component|token|layer|type|rule|part)(\\s+)([A-Za-z_][A-Za-z0-9_./%$-]*)",
      "captures": {
        "1": {
          "name": "keyword.control.milda"
        },
        "3": {
          "name": "entity.name.type.milda"
        }
      }
    },
    "operator": {
      "match": "->|→|<=|>=|!=|[=:]",
      "name": "keyword.operator.milda"
    },
    "keyword": {
      "match": "(?<![A-Za-z0-9_./%$-])(?:context-group|described-by|presentation|foundations|global-prop|labelled-by|destination|labeled-by|transition|component|archetype|broadcast|behaviour|copyright|otherwise|required|requires|ancestor|keyed-by|optional|instance|behavior|prelude|because|realize|present|compute|default|payload|foreign|example|one-of|any-of|within|prefer|events|motion|layout|escape|commit|active|single|signal|locked|repeat|assets|anchor|milda|token|where|never|props|state|alias|arena|false|emits|icons|meta|type|rule|uses|wire|gate|part|when|slot|from|bind|drop|note|many|true|pill|a11y|demo|docs|and|not|raw|or|by|as|on|of)(?![A-Za-z0-9_./%$-])",
      "name": "keyword.control.milda"
    },
    "type": {
      "match": "(?<![A-Za-z0-9_./%$-])(?:boolean|context|string|number|object|scaled|array|union|oklch|enum|srgb|rgba|hsla|ref|hex|rgb|hsl|p3)(?![A-Za-z0-9_./%$-])",
      "name": "support.type.milda"
    },
    "number": {
      "match": "(?<![A-Za-z0-9_./%$-])-?\\d+(?:\\.\\d+)?[a-z%]*(?![A-Za-z0-9_./%$-])",
      "name": "constant.numeric.milda"
    },
    "variable": {
      "match": "(?<![A-Za-z0-9_./%$-])\\$[A-Za-z0-9_./%$-]*(?![A-Za-z0-9_./%$-])",
      "name": "variable.parameter.milda"
    },
    "property": {
      "match": "(?<![A-Za-z0-9_./%$-])(?=[A-Za-z0-9_./%$-]*\\.)[A-Za-z0-9_./%$-]+(?![A-Za-z0-9_./%$-])",
      "name": "variable.other.property.milda"
    }
  }
}
